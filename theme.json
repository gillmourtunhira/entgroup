{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1216px"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "palette": [
        { "slug": "paper", "name": "Paper", "color": "#ffffff" },
        { "slug": "mist", "name": "Mist", "color": "#f3f8f7" },
        { "slug": "teal", "name": "Teal", "color": "#247b78" },
        { "slug": "navy", "name": "Navy", "color": "#16353d" },
        { "slug": "ink", "name": "Ink", "color": "#24383d" }
