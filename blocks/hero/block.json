{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "entgroup/hero",
  "version": "1.0.0",
  "title": "ENT Hero",
  "category": "entgroup",
  "icon": "cover-image",
  "description": "Page introduction with calls to action and an image.",
  "keywords": ["banner", "header", "intro"],
  "textdomain": "entgroup",
  "style": "entgroup-block-hero-style",
  "supports": { "anchor": true, "align": ["wide", "full"], "html": false, "multiple": false },
  "acf": {
    "blockVersion": 3,
    "mode": "preview",
    "renderTemplate": "render.php",
    "fields": [
      { "label": "Autoplay", "name": "autoplay", "type": "true_false", "default_value": 0, "message": "Automatically advance slides every 6 seconds", "ui": 0, "instructions": "Requires at least two slides. Visitors can pause playback. Reduced-motion preferences are respected." },
      { "label": "Eyebrow", "name": "eyebrow", "type": "text", "default_value": "Specialist ENT care in Zimbabwe" },
      { "label": "Heading", "name": "heading", "type": "text", "required": 1, "default_value": "Expert care for your ear, nose and throat health" },
      { "label": "Introduction", "name": "intro", "type": "textarea", "rows": 3, "default_value": "Experienced specialists, thorough diagnosis and modern treatment." },
      { "label": "Image", "name": "image", "type": "image", "return_format": "id", "preview_size": "medium" },
      { "label": "Primary action", "name": "primary_action", "type": "link", "return_format": "array" },
      { "label": "Secondary action", "name": "secondary_action", "type": "link", "return_format": "array" },
      { "label": "Additional slides", "name": "slides", "type": "repeater", "layout": "block", "max": 4, "button_label": "Add slide", "instructions": "The fields above remain the first slide. Add up to four more slides here.", "sub_fields": [
        { "label": "Eyebrow", "name": "eyebrow", "type": "text" },
        { "label": "Heading", "name": "heading", "type": "text", "required": 1 },
        { "label": "Introduction", "name": "intro", "type": "textarea", "rows": 3 },
        { "label": "Background image", "name": "image", "type": "image", "return_format": "id", "preview_size": "medium" },
        { "label": "Primary action", "name": "primary_action", "type": "link", "return_format": "array" },
        { "label": "Secondary action", "name": "secondary_action", "type": "link", "return_format": "array" }
      ] }
    ]
  }
}
