{% set locations = fields.locations|default([
  {name: 'Harare Main Centre', address: '93 Baines Avenue, Harare'},
  {name: 'Borrowdale', address: '10 Malcolm Road, Borrowdale'},
  {name: 'Chitungwiza', address: 'Suite 2, CitiMed Hospital'},
  {name: 'Mutare', address: '7th Avenue Surgical Unit'}
]) %}
<section id="{{ block_id|e('html_attr') }}" class="{{ block_classes|e('html_attr') }} section"><div class="container">
  {% if fields.eyebrow %}<p class="eyebrow">{{ fields.eyebrow|e }}</p>{% endif %}
  <h2>{{ fields.heading|default('Four clinics, one standard of care')|e }}</h2>
  <div class="location-grid">
    {% for location in locations %}
    <article class="location">
      <span class="ent-icon-tile"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
      <h3>{{ location.name|e }}</h3>
      {% if location.address %}<p class="location__address">{{ location.address|e|nl2br }}</p>{% endif %}
      {% if location.phone or location.map_link %}
      <div class="location__contact">
        {% if location.phone %}<a class="ent-icon-link" href="{{ function('esc_url', 'tel:' ~ location.phone|replace({' ': '', '-': ''})) }}"><i class="fa-solid fa-phone" aria-hidden="true"></i>{{ location.phone|e }}</a>{% endif %}
        {% if location.map_link %}<a class="ent-icon-link text-link" href="{{ function('esc_url', location.map_link) }}"><i class="fa-solid fa-route" aria-hidden="true"></i>Get directions</a>{% endif %}
      </div>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</div></section>
