{% set image = fields.image ? get_image(fields.image) : null %}
<section id="{{ block_id }}" class="{{ block_classes }} section section--{{ fields.background|default('white') }}">
  <div class="container media-content {{ fields.image_position == 'left' ? 'media-content--reverse' }}">
    <div class="media-content__copy">
      {% if fields.eyebrow %}<p class="eyebrow">{{ fields.eyebrow }}</p>{% endif %}
      <h2>{{ fields.heading|default('Specialist knowledge, thoughtfully delivered') }}</h2>
      <div class="prose">{{ function('wp_kses_post', fields.content|default('<p>Add approved content for this section.</p>'))|raw }}</div>
      {% if fields.link %}<a class="text-link" href="{{ fields.link.url }}" target="{{ fields.link.target|default('_self') }}">{{ fields.link.title }} <span aria-hidden="true">→</span></a>{% endif %}
    </div>
    <div class="media-content__image">{% if image %}<img src="{{ image.src('large') }}" width="{{ image.width }}" height="{{ image.height }}" alt="{{ image.alt }}">{% else %}<span>Approved photography</span>{% endif %}</div>
  </div>
</section>
